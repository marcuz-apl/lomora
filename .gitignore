.env

# WorkBuddy session notes; not part of the shipped source.
.workbuddy-ai/

.worktrees/

.superpowers/

target/
*.db

# Runtime state, never source: the SQLite database, its ad-hoc backups, journals and the
# Unix daemon's pid file. Created on first run beside the working directory.
data/

# Editor settings are per-machine, not source; keep the directory out of the repository.
.vscode/

# The npm launcher downloads the release binary here on first run; never commit it (it is
# platform-specific and ~9 MiB). `files` in npm/package.json excludes it from publishes.
npm/bin/lomora
npm/bin/lomora.exe
npm/bin/.*.download
